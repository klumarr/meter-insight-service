# Copy this file to .env and fill in real values.
#
#     cp .env.example .env
#
# .env is gitignored and must never be committed. This file lists the names of
# the variables the service reads, and nothing else.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Created in a Claude Console workspace that has its own spend limit, so this
# key cannot spend beyond that cap. The test suite mocks the model and does not
# need a key.
ANTHROPIC_API_KEY=

# Optional. Defaults are in config/settings.py.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_TOKENS=1024

# How long model-written recommendations stay usable. The cache key already
# covers the readings, the model and the prompt, so this only bounds how long
# wording can outlive a change to any of them.
INSIGHT_CACHE_SECONDS=3600
